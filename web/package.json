{
  "name": "xmake-packages-index-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/check-seo.mjs",
    "preview": "vite preview --host",
    "test": "node --test scripts/*.test.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "prebuild": "node --test scripts/*.test.mjs && node scripts/generate-relations.mjs",
    "predev": "node scripts/generate-relations.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "vue": "^3.4.27",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@vitejs/plugin-vue": "^5.0.5",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vue-tsc": "^2.0.21"
  }
}
